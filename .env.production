# Vite production modu (npm run build). API + bundler proxy production backend'e bakar.
# Gizli DEGIL (URL zaten uygulamada public). Bu dosya commit'lenir.
VITE_API_URL=https://api.extension.watswallet.com
VITE_BUNDLER_BASE=https://api.extension.watswallet.com

# Solana ozelligi. Kod depoda DURUYOR ama YAYINA CIKMAZ: 'true' disindaki her
# deger (ve degiskenin hic olmamasi) kapatir.
#
# Kapali oldugunda kapanan uc yer: (1) manifest'e solanaInjected.js content
# script'i YAZILMAZ, (2) arka plan dagiticisi butun SOLANA_*/solana_* aksiyonlarini
# reddeder, (3) Solana zincir kaydi desteklenen aglar listesinden dusurulur --
# yani ag secici, ana ekran, Al/Gonder ve gezgin yollari kendiliginde kapanir.
#
# Testlerde ACIK (vitest.config.js -> test.env): kapali diye test edilmemesi,
# bayrak yeniden acildiginda dogrulanmamis bir ozellik yayina cikmasi demekti.
VITE_SOLANA_ENABLED=false

# Kullanim istatistigi (gunluk ping). YAYINDA KAPALI: 'true' disindaki her
# deger (ve degiskenin hic olmamasi) kapatir. Yalnizca yayimli gizlilik politikasi,
# Chrome Web Store Privacy practices sekmesi ve bir kerelik bildirim karti hazir bir
# surum derlemesinde 'true' yapilir; aksi halde bir hotfix derlemesi telemetriyi
# magazaya kendiliginden sokar.
# Testlerde ACIK (vitest.config.js -> test.env).
VITE_ANALYTICS_ENABLED=false

# xStocks (tokenize hisse) ozelligi. 'true' disindaki her deger (ve degiskenin hic olmamasi)
# kapatir. Kapaliyken: Hisseler sekmesi bStocks gorunumunde, Token.vue xStock dallarina
# girilmez. Takas/Kopru dislamasi bayraktan BAGIMSIZ calisir (koruyucu).
#
# Testlerde ACIK (vitest.config.js -> test.env).
VITE_XSTOCKS_ENABLED=true
# ATS ile ag ucreti: KAPALI. Testlerde ACIK.
VITE_XSTOCKS_ATS_FEE_ENABLED=false
