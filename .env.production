# Vite production modu (npm run build). API + bundler proxy production backend'e bakar.
# Gizli DEGIL (URL zaten uygulamada public). Bu dosya commit'lenir.
VITE_API_URL=https://api.extension.watswallet.com
VITE_BUNDLER_BASE=https://api.extension.watswallet.com

# Solana ozelligi. Kod depoda DURUYOR ama YAYINA CIKMAZ: 'true' disindaki her
# deger (ve degiskenin hic olmamasi) kapatir.
#
# Kapali oldugunda kapanan uc yer: (1) manifest'e solanaInjected.js content
# script'i YAZILMAZ, (2) arka plan dagiticisi butun SOLANA_*/solana_* aksiyonlarini
# reddeder, (3) Solana zincir kaydi desteklenen aglar listesinden dusurulur --
# yani ag secici, ana ekran, Al/Gonder ve gezgin yollari kendiliginde kapanir.
#
# Testlerde ACIK (vitest.config.js -> test.env): kapali diye test edilmemesi,
# bayrak yeniden acildiginda dogrulanmamis bir ozellik yayina cikmasi demekti.
VITE_SOLANA_ENABLED=false

# Gizli mod (Gizli Hesap) tek aciklik anahtari. Testler bunu vitest.config.js'ten DEGIL,
# kendileri vi.stubEnv ile acar. 1.10 magaza surumunde ACIK (sahip karari 2026-10-29): sade Para yukle/Gonder ekrani, ag ucreti HER
# islemde ATS (sahip karari 2026-10-30: "native olmaz ats olacak"), gizli modda Takas/Kopru ACIK (asagidaki bayrak); gizli modda ATS
# satisi ACIK (asagida). Kilit: buildConfigGuards.test.js. Derleme kapilari
# (manifest.config.js): gecerli integratorId (asagida), teslim ag listeleri degismezleri.
VITE_PRIVACY_ENABLED=true

# Gizli mod / SilentSwap integratorId (Plan 2). KAMUYA ACIK deger (sir degil); partner yaniti
# gelince doldurulur. Uretim paketine manifest `key` YAZILMAZ: magaza kaydinin public key degiskeni
# (VITE_EXTENSION_PUBLIC_KEY) bu dosyada YOKTUR; yalniz gelistirme derlemesi icin .env.development'ta
# (yorum satiri olarak) ve kisisel .env.development.local'de yer alir.
# Kapi MEKANIKTIR (manifest.config.js, yapilandirma yuklenirken derlemeyi durdurur): bos olmayan id
# "int_" + 24 kucuk harf/rakam bicimine uymuyorsa HER modda, VITE_PRIVACY_ENABLED=true iken bos id
# URETIM derlemesinde hata verir. Yani bu satir bos kalirken Gizli mod acik uretim derlemesi yapilamaz.
VITE_SILENTSWAP_INTEGRATOR_ID=int_c158318f1bc41cecf62fec12

# Kullanim istatistigi (gunluk ping). 1.10.1 ile BILEREK ACILDI (2026-11-13): gizlilik politikasi
# https://watswallet.github.io/privacy-policy/ adresinde yayinda, Chrome Web Store Privacy practices
# formu guncellendi, nginx erisim gunlugu kapali, sunucu (summary ekip anahtari + 13 ay silme) canlida.
# Acik olsa da kullanici onay penceresinde 'Kabul et' demeden hicbir sey gonderilmez (kayit yok = KAPALI).
# Kapatmak icin 'false' yaz; 'true' disindaki her deger kapatir. Testlerde ACIK (vitest.config.js -> test.env).
VITE_ANALYTICS_ENABLED=true

# xStocks (tokenize hisse) ozelligi. 'true' disindaki her deger (ve degiskenin hic olmamasi)
# kapatir. Kapaliyken: Hisseler sekmesi bStocks gorunumunde, Token.vue xStock dallarina
# girilmez. Takas/Kopru dislamasi bayraktan BAGIMSIZ calisir (koruyucu).
#
# Testlerde ACIK (vitest.config.js -> test.env).
VITE_XSTOCKS_ENABLED=true
# ATS ile ag ucreti: KAPALI. Testlerde ACIK.
VITE_XSTOCKS_ATS_FEE_ENABLED=false

# Gizli mod teslim aglari (SP2, spec 4.2, 6.1-6.3): virgulle ayrilmis zincir kimlikleri; bos = o ekran icin HICBIR ag acik
# degil. 1.10 magaza surumu (sahip karari 2026-10-29: yalniz BSC degil diger aglar da acik):
#   Gonder      : on agin hepsi (Ethereum, BSC, Base, Arbitrum, Optimism, Polygon, Gnosis, Celo, Mantle, Cronos).
#   Para yukle  : TESLIM DEGISMEZINI saglayan aglar. Gizli Hesap'a teslim edilen varlik YALNIZ Gonder ile cikabilir (bu surumde
#                 ana cikis yolu Gonder), bu yuzden Para yukle'deki her agin en az bir Gonder kaynagi olmali
#                 (koprulu kaynaklar acik); teslim edilebilen varlik = YALNIZ o agdaki Gonder kaynaklari (ag ucreti ATS ile odenir,
#                 yerel coin gaz istisnasi YOK: BNB, POL, xDAI, CELO, MNT, CRO teslim edilmez; ETH yalniz ETH aglarinda).
#                 Gonder kaynaklari: 56 USDC | 1 USDC,USDT,DAI,ETH | 8453 USDC,ETH | 42161 USDC,USDT,ETH | 10 USDC,USDT,ETH |
#                 137 USDC,USDT | 100, 42220, 5000, 25 USDC. Hepsinin kaynagi var, bu yuzden Para yukle de on ag.
# Derleme kapisi (manifest.config.js) bunu mekanik denetler: Para yukle'deki her agin Gonder kaynagi yoksa derleme durur; liste 56'yi
# icermeli; Para yukle Gonder'in altkumesi. Kilit: buildConfigGuards.test.js.
VITE_PRIVATE_SEND_CHAINS=1,56,8453,42161,10,137,100,42220,5000,25
VITE_PRIVATE_FUND_CHAINS=1,56,8453,42161,10,137,100,42220,5000,25

# Gizli Hesap ATS satin alma (gizli-mod cok-ag spec 4.5 madde 2, K13, E18): 1.10 YAYININDA ACIK. Sahip karariyla acildi (2026-11-06, spec 6.11;
# bu commit kilidi ve manifest.config.js kuralini birlikte degistirir). Para yukle genisligi buna BAGLI DEGIL, teslim degismezi Gonder
# kaynagina baglidir. Bayrak yoksa kapalidir.
VITE_PRIVATE_ATS_SALE=true

# Gizli modda Takas ve Kopru (1.10 magaza surumu): ACIK (sahip karari 2026-11-06). Bundler Gizli adresi gorur. Kilit buildConfigGuards.test.js'te. Bayrak yoksa kapalidir.
VITE_PRIVATE_SWAP_BRIDGE=true
