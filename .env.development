# Vite development modu (npm run dev). API + bundler proxy lokal backend'e bakar.
# Gizli DEGIL (yalnizca URL). Bu dosya commit'lenir. DIKKAT: mod-ozel dosya .env.local'i EZER;
# kisisel override icin .env.development.local kullanin (gitignore'da, yalniz gelistirmede okunur).
VITE_API_URL=http://localhost:8000
VITE_BUNDLER_BASE=http://localhost:8000

# Solana ozelligi. Kod depoda DURUYOR ama YAYINA CIKMAZ: 'true' disindaki her
# deger (ve degiskenin hic olmamasi) kapatir.
#
# Kapali oldugunda kapanan uc yer: (1) manifest'e solanaInjected.js content
# script'i YAZILMAZ, (2) arka plan dagiticisi butun SOLANA_*/solana_* aksiyonlarini
# reddeder, (3) Solana zincir kaydi desteklenen aglar listesinden dusurulur --
# yani ag secici, ana ekran, Al/Gonder ve gezgin yollari kendiliginde kapanir.
#
# Testlerde ACIK (vitest.config.js -> test.env): kapali diye test edilmemesi,
# bayrak yeniden acildiginda dogrulanmamis bir ozellik yayina cikmasi demekti.
VITE_SOLANA_ENABLED=false

# Gizli mod (Gizli Hesap) tek aciklik anahtari. Testler bunu vitest.config.js'ten DEGIL,
# kendileri vi.stubEnv ile acar. Uretimde (.env.production) spec bolum 12'deki yayin
# kapilari gecene kadar false KALIR; gelistirmede aciktir.
VITE_PRIVACY_ENABLED=true

# Gizli mod / SilentSwap (Plan 2). Ikisi de KAMUYA ACIK degerdir (sir degil); partner yaniti ve
# magaza kaydi gelince doldurulur, o zamana kadar YORUMDA kalir (bos birakilan satir .env.local'i
# sessizce ezerdi). INTEGRATOR_ID'yi SilentSwap verir: kamuya acik oldugu icin YALNIZ bu dosyada
# (commit'lenir) doldurulur. EXTENSION_PUBLIC_KEY magaza paketinin "Public key" degeridir:
# .env.development.local'e yazilir, buraya YAZILMAZ (yalniz gelistirme derlemesinin manifest'ine
# `key` olarak girer, bkz. manifest.config.js). Ozelligi acan tek anahtar VITE_PRIVACY_ENABLED'dir.
# UYARI: anahtar dolunca her gelistirme derlemesi magaza kimligini tasir; gelistirme derlemesini
# YALNIZ gercek kasa icermeyen ayri bir Chrome profilinde yukleyin.
VITE_SILENTSWAP_INTEGRATOR_ID=int_c158318f1bc41cecf62fec12
# VITE_EXTENSION_PUBLIC_KEY=

# xStocks (tokenize hisse) ozelligi. 'true' disindaki her deger (ve degiskenin hic olmamasi)
# kapatir. Kapaliyken: Hisseler sekmesi bStocks gorunumunde, Token.vue xStock dallarina
# girilmez. Takas/Kopru dislamasi bayraktan BAGIMSIZ calisir (koruyucu).
#
# Testlerde ACIK (vitest.config.js -> test.env).
VITE_XSTOCKS_ENABLED=false

# Gizli mod teslim aglari (SP2, spec 4.2): virgulle ayrilmis zincir kimlikleri. Degisken yok ya da bos = o ekran icin
# HICBIR ag acik degil (fail-closed). GONDER: teslim agi olarak secilebilen aglar; gelistirmede on agin hepsi acik (sahip
# test edebilsin). PARA YUKLE: Gonder listesinin altkumesi; gelistirmede o da on agin hepsi (sahip BSC disi Para yukle'yi ve ATS
# satin almayi deneyebilsin). BSC disi Para yukle satin alma yolu ister (cikis ATS ucretine bagli): asagidaki VITE_PRIVATE_ATS_SALE=true
# ve isAtsSaleLive() birlikte aciksa derlenir (degismez (c)); biri kapaliysa derleme kapisi (manifest.config.js) durur. Kapi gecersiz
# ogeyi ve degismez ihlalini HER modda reddeder. Magaza listeleri (.env.production) kanitlanan aglarla tek tek doldurulur.
VITE_PRIVATE_SEND_CHAINS=1,56,8453,42161,10,137,100,42220,5000,25
VITE_PRIVATE_FUND_CHAINS=1,56,8453,42161,10,137,100,42220,5000,25

# Gizli Hesap ATS satin alma (gizli-mod cok-ag spec 4.5 madde 2, K13, E18): GELISTIRMEDE ACIK (sahip canli adim 5.2/1 ve
# satin alma ekranini deneyebilsin). Fonlu denemeler gercek paraya gider: ATS satis istekleri VITE_BUNDLER_BASE ne olursa olsun
# bundler.watswallet.com a sabit gider. Uretimde (.env.production) canli kanit ve yayin kapisi 6.11 gecene dek false KALIR.
VITE_PRIVATE_ATS_SALE=true

# Gizli modda kendine Takas ve Kopru (SilentSwap, private_swap / private_bridge ekranlari): gelistirmede ACIK (sahip ekranlari
# deneyebilsin). Klasik Takas/Kopru gizli modda bu bayraktan BAGIMSIZ kapalidir. Uretimde (.env.production) KAPALI: acmak ayri
# bir insan commit'idir. Normal mod bu bayraktan ETKILENMEZ.
VITE_PRIVATE_SWAP_BRIDGE=true
